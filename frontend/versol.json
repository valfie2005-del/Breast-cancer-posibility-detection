
{
  "$schema": "https://breast-cancer-posibility-detection.vercel.app",
  "services": {
    "app": {
      "root": ".",
      "entrypoint": "app:app",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend",
      "framework": "create-react-app"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
